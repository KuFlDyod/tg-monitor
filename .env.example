# Never commit .env or data/*.session. chmod 600 .env
TG_API_ID=0
TG_API_HASH=
TG_PHONE=
SESSION_PATH=./data/collector
BOT_TOKEN=
BOT_CHAT_ID=0
# Defaults to BOT_CHAT_ID. Only positive Telegram user IDs, private chats only.
ALLOWED_USER_IDS=
AI_ENABLED=true
AI_API_KEY=
# Include provider's API prefix, normally https://provider.example/v1
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT=60
AI_MAX_CONCURRENCY=2
AI_DAILY_BUDGET=200
# Conservative UTF-8 byte-based input budget, not exact tokenizer accounting.
AI_INPUT_TOKENS=6000
AI_OUTPUT_TOKENS=1200
AI_JSON_MODE=true
# Some models require max_completion_tokens instead of max_tokens.
AI_TOKEN_PARAMETER=max_tokens
DATABASE_PATH=./data/telegram.db
# HTTP_PROXY used by Bot and AI. Set only if required on your server.
HTTP_PROXY=
# Telethon does not use HTTP_PROXY automatically. Explicit proxy:
TG_PROXY=
# Example (local development): http://127.0.0.1:7890
HISTORY_LIMIT=300
MESSAGE_QUEUE_SIZE=2000
DB_BATCH_SIZE=100
DB_FLUSH_INTERVAL=1
SYNC_INTERVAL=120
TIMEZONE=Asia/Shanghai
REPORT_HOUR=21
REPORT_MINUTE=0
REPORT_COMBINED=true
RETENTION_DAYS=90
CACHE_DAYS=30
BACKUP_DAYS=7
SEARCH_DAYS=30
LOG_LEVEL=INFO
LOG_DIR=./logs
